# spotifyd — the "Downtify Mirror" example config
#
# Copy this file to `spotifyd.conf` next to it, fill in your Spotify
# username and password (enter them yourself: the real file is kept
# out of git), then run: docker compose up -d spotifyd
#
# The account must be Premium and must be the same account the Spotify
# Mirror is connected with in Downtify.

[global]
username = 'your-spotify-username'
password = 'your-spotify-password'

# The name the web UI's device picker shows; keep it, the docs
# reference it.
device_name = 'Downtify Mirror'
device_type = 'computer'

# No sound card on the server: ALSA's built-in null device swallows
# the stream, and the volume starts at 0 anyway.
backend = 'alsa'
alsa_device = 'null'
initial_volume = 0
volume_normalisation = false

# Stream quality.
bitrate = 320

# Credentials/token cache for restarts (compose mounts this volume).
cache_path = '/cache'